{
  "id": "buzz.claude-code",
  "name": "Claude",
  "apiVersion": 1,
  "host": {
    "processes": [
      { "id": "claude", "program": "claude" },
      {
        "id": "install",
        "program": "bash",
        "args": ["-c", "curl -fsSL https://claude.ai/install.sh | bash"]
      },
      { "id": "read", "program": "base64", "args": ["-i"] },
      { "id": "workspace", "program": "pwd" },
      {
        "id": "find",
        "program": "grep",
        "args": ["-rlF", "--include=*.jsonl", "-e"]
      }
    ]
  }
}
